# Скопируйте в .env и заполните. Секреты не коммитить.
# Сгенерировать ключи: python -m pauza.cli gen-keys

APP_ENV=development              # development | test | production
APP_LOG_LEVEL=INFO
PUBLIC_BASE_URL=https://bot.example.com   # в production только https

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=         # 1–256 символов A-Z a-z 0-9 _ -; в production ≥ 32
ID_HASH_KEY=                     # ключ keyed hash для Telegram ID (≥ 32 символов)
CALLBACK_SIGNING_KEY=            # ключ подписи кнопок (≥ 32 символов)
QUEUE_ENCRYPTION_KEY=            # Fernet-ключ шифрования очереди

DATABASE_URL=postgresql+asyncpg://pauza:pauza@postgres:5432/pauza
REDIS_URL=redis://redis:6379/0

# Лимиты
MAX_TEXT_LENGTH=10000
MAX_IMAGE_BYTES=10485760
MAX_IMAGE_PIXELS=20000000
MAX_URLS_PER_CHECK=10
MAX_WEBHOOK_BODY_BYTES=1048576
RATE_LIMIT_WINDOW_SECONDS=600
RATE_LIMIT_MAX_CHECKS=10
RATE_LIMIT_DAILY_MAX_CHECKS=50
WEBHOOK_IP_RATE_LIMIT_PER_MINUTE=3000

# Хранение
TEMP_DATA_TTL_SECONDS=900        # ≤ 900
CHECK_RETENTION_DAYS=365
USER_INACTIVITY_DAYS=            # пусто = не удалять по неактивности (решение раздела 21 п.4)

# Таймауты и повторы
ANALYSIS_TIMEOUT_SECONDS=10
OCR_TIMEOUT_SECONDS=15
TELEGRAM_TIMEOUT_SECONDS=10
TELEGRAM_MAX_ATTEMPTS=5
TELEGRAM_MAX_MESSAGE_AGE_SECONDS=300
JOB_MAX_ATTEMPTS=3

# Провайдеры (безопасные значения по умолчанию)
OCR_PROVIDER=tesseract           # tesseract | disabled
OCR_LANGUAGES=rus+eng
OCR_API_KEY=
LLM_ENABLED=false
LLM_PROVIDER=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=5
URL_REPUTATION_ENABLED=false
URL_REPUTATION_PROVIDER=
URL_REPUTATION_API_KEY=

DEFAULT_LOCALE=ru
DEFAULT_REGION_CODE=
CONSENT_VERSION=2026-11-draft
OFFICIAL_DOMAINS_FILE=config/official_domains.json
METRICS_PORT=9100
